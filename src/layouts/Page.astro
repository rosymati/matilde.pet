---
import Base from '@/layouts/Base.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<Base title={`${title} · Matilde`} description={description}>
	<div class="px-5 pb-12 sm:px-12 sm:pb-20">
		<div class="mx-auto max-w-240 pt-8 wrap-anywhere sm:pt-16">
			<slot />
		</div>
	</div>
</Base>
