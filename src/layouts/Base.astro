---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Matilde', description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{description && <meta name="description" content={description} />}
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Mati's Blog"
			href={new URL('rss.xml', Astro.site)}
		/>
		<title>{title}</title>
		<ClientRouter />
		<Font cssVariable="--instrument" preload />
		<Font cssVariable="--dm-sans" preload />
	</head>
	<body
		class="selection:bg-pigment selection:text-paper [&_a:focus-visible]:outline-pigment relative min-h-svh [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4"
	>
		<a
			class="bg-pigment text-paper fixed top-3 left-3 z-20 translate-y-[-160%] px-5 py-3 focus:translate-y-0"
			href="#content">Skip to content</a
		>
		<div
			class="bg-paper-grain pointer-events-none absolute inset-0 z-10 bg-size-[192px_512px] bg-repeat opacity-50 mix-blend-multiply"
			aria-hidden="true"
		>
		</div>
		<main id="content" tabindex="-1">
			<slot />
		</main>
	</body>
</html>
