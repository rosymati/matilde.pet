---
import Page from '@/layouts/Page.astro';
import PageHeader from '@/components/PageHeader.astro';
import { projects } from '@/config';
---

<Page title="Projects" description="Things I've built and contributed to.">
	<PageHeader title="work" subtitle="things i've built and tinkered with" />
	<ul class="border-rule divide-rule divide-y border-y">
		{
			projects.map((project) => (
				<li>
					<a
						class="group grid grid-cols-[1fr_auto] items-center gap-x-8 gap-y-4 py-8 sm:grid-cols-[1fr_1fr_auto]"
						href={project.href}
						target="_blank"
						rel="noopener noreferrer"
					>
						<div>
							<h2 class="font-instrument group-hover:text-pigment text-4xl leading-tight tracking-tight group-hover:underline sm:text-5xl">
								{project.name}
							</h2>
							<p class="text-leaf mt-3 text-xs">{project.tags.join(' / ')}</p>
						</div>
						<p class="text-copy col-start-1 row-start-2 sm:col-start-2 sm:row-start-1">
							{project.description}
						</p>
						<span
							class="text-pigment col-start-2 row-start-1 text-2xl sm:col-start-3"
							aria-hidden="true"
						>
							↗
						</span>
					</a>
				</li>
			))
		}
	</ul>
</Page>
