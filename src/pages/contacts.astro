---
import Page from '@/layouts/Page.astro';
import PageHeader from '@/components/PageHeader.astro';
import { contacts } from '@/config';
---

<Page title="Contacts" description="Find me around the internet.">
	<PageHeader title="say hello" subtitle="find me around the internet" />
	<ul class="border-rule divide-rule divide-y border-y">
		{
			Object.values(contacts).map((contact) => (
				<li>
					<a
						class="group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-2 py-6 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] sm:gap-x-6"
						href={contact.href}
						target={contact.href.startsWith('https:') ? '_blank' : undefined}
						rel={
							contact.href.startsWith('https:')
								? 'noopener noreferrer'
								: undefined
						}
					>
						<h2 class="font-instrument group-hover:text-pigment text-4xl leading-tight tracking-tight group-hover:underline">
							{contact.name}
						</h2>
						<p class="text-copy col-span-2 col-start-1 row-start-2 sm:col-span-1 sm:col-start-2 sm:row-start-1">
							{contact.handle}
						</p>
						<span
							class="text-pigment col-start-2 row-start-1 text-2xl sm:col-start-3"
							aria-hidden="true"
						>
							↗
						</span>
					</a>
				</li>
			))
		}
	</ul>
</Page>
