---
import Page from '@/layouts/Page.astro';
import PageHeader from '@/components/PageHeader.astro';
import Comments from '@/components/Comments.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Page title={post.data.title} description={post.data.description}>
	<article class="mx-auto max-w-176">
		<PageHeader
			title={post.data.title}
			backHref="/blog"
			backLabel="back to notes"
		>
			<time
				datetime={post.data.pubDate.toISOString()}
				class="text-muted mb-5 block text-xs"
			>
				{formatDate(post.data.pubDate)}
			</time>
		</PageHeader>
		<div
			class="prose prose-headings:font-instrument prose-headings:font-normal prose-headings:tracking-tight prose-a:decoration-pigment/40 hover:prose-a:decoration-pigment prose-blockquote:font-instrument prose-blockquote:text-2xl prose-pre:rounded-none prose-pre:border-y prose-pre:border-rule prose-pre:p-4 sm:prose-pre:p-5 prose-pre:text-sm prose-pre:leading-relaxed prose-pre:focus-visible:outline-pigment prose-img:mx-auto prose-table:block prose-table:overflow-x-auto max-w-none"
		>
			<Content />
		</div>
		<section
			class="border-rule mt-12 border-t pt-6 sm:mt-16 sm:pt-8"
			aria-label="Comments"
		>
			<Comments />
		</section>
	</article>
</Page>
