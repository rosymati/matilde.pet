---
import Page from '@/layouts/Page.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '@/utils';

const posts = (await getCollection('blog')).toSorted(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Page
	title="Blog"
	description="Posts about development, open source, and life."
>
	<PageHeader
		title="notes"
		subtitle="thoughts, projects, and the occasional ramble"
	/>
	{
		posts.length === 0 ? (
			<p class="text-copy">No posts yet — check back soon!</p>
		) : (
			<ul class="border-rule divide-rule divide-y border-y">
				{posts.map((post) => (
					<li>
						<a class="group block py-8" href={`/blog/${post.id}/`}>
							<time
								datetime={post.data.pubDate.toISOString()}
								class="text-muted text-xs"
							>
								{formatDate(post.data.pubDate)}
							</time>
							<h2 class="font-instrument group-hover:text-pigment mt-3 mb-4 text-4xl leading-tight tracking-tight group-hover:underline sm:text-5xl">
								{post.data.title}
							</h2>
							<p class="text-copy max-w-160">{post.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		)
	}
	<a
		class="text-pigment mt-8 inline-block py-3 hover:underline"
		href="/rss.xml"
	>
		subscribe via RSS <span class="ml-1.75" aria-hidden="true">↗</span>
	</a>
</Page>
