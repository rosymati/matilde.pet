---
import Title from '@/components/Title.astro';

interface Props {
	title: string;
	subtitle?: string;
	backHref?: string;
	backLabel?: string;
}

const {
	title,
	subtitle,
	backHref = '/',
	backLabel = 'back home',
} = Astro.props;
---

<a
	class="text-pigment mb-6 inline-flex min-h-11 items-center py-3 hover:underline sm:mb-8"
	href={backHref}
>
	<span class="mr-1.75" aria-hidden="true">←</span>
	{backLabel}
</a>
<header class="mb-10 sm:mb-16">
	<slot />
	<Title title={title} />
	{
		subtitle && (
			<p class="font-instrument text-copy mt-4 text-2xl leading-[1.3] italic sm:mt-5 sm:text-[28px]">
				{subtitle}
			</p>
		)
	}
</header>
