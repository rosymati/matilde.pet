---
const links = [
	{ href: '/projects', label: 'work' },
	{ href: '/blog', label: 'notes' },
	{ href: '/contacts', label: 'say hello' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
---

<nav
	class="border-rule flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-b py-6"
	aria-label="Main navigation"
>
	<a
		class="font-instrument text-pigment text-4xl leading-none tracking-[-0.057em]"
		href="/"
		aria-label="Matilde, home">Matilde<span class="text-ink">.</span></a
	>
	<div class="flex flex-wrap items-center gap-6 sm:gap-8">
		{
			links.map(({ href, label }) => (
				<a
					href={href}
					aria-current={path === href ? 'page' : undefined}
					class:list={[
						'hover:text-pigment py-3 hover:underline',
						(path === href || path.startsWith(`${href}/`)) &&
							'text-pigment underline',
					]}
				>
					{label}
				</a>
			))
		}
	</div>
</nav>
