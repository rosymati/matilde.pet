{
	"name": "rosymati.com",
	"type": "module",
	"version": "0.0.1",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.3.1",
			"onFail": "download"
		},
		"runtime": [
			{
				"name": "node",
				"version": "24.20.0",
				"onFail": "download"
			}
		]
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "prettier --check .",
		"format:fix": "prettier --write --list-different .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"@astrojs/rss": "4.0.19",
		"astro": "7.3.1",
		"giscus": "^1.6.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/sitemap": "^3.7.4",
		"@prettier/plugin-oxc": "^0.2.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"oxlint": "^1.81.0",
		"prettier": "=3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^6.0.3"
	}
}
